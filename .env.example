# Directorios de salida y perfil persistente
OUTPUT_DIR=./descargas
PROFILE_DIR=./perfil_navegador

# URL base del curso en AWS Academy (Canvas LMS)
AWS_HOME_URL=https://awsacademy.instructure.com/courses/000000/modules

# Credenciales de acceso AWS Academy (opcional, para auto-login sin tener que ingresarlas a mano)
AWS_USER=tu_usuario_o_email
AWS_PASSWORD=tu_contraseña

# Timeouts (en segundos)
VIEWER_LOAD_TIMEOUT=240
PAGE_RENDER_TIMEOUT=90
VIDEO_LOAD_TIMEOUT=180
AUTO_DETECT_TIMEOUT=120

# Perfil de compresión de video con FFmpeg
VIDEO_MAX_HEIGHT=720
VIDEO_CRF=24
VIDEO_PRESET=slow
AUDIO_BITRATE=64k
BURN_SUBTITLES=1
# FFMPEG_PATH=C:\ruta\a\ffmpeg.exe

# Sincronización con Google Drive (opcional)
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=https://drive.google.com/drive/folders/TU_ID_DE_CARPETA
GOOGLE_DRIVE_CREDENTIALS=private/credentials_drive.json
GOOGLE_DRIVE_TOKEN=private/token_drive.json

# Checkpoints y reanudación
RESUME_ENABLED=true
FORCE_REDOWNLOAD=false

# Simulación de interacción humana (Reproducir contenido)
# SIM_PDF_PAGE_SECONDS=12
# SIM_HTML_READING_SECONDS=10
# SIM_VIDEO_SPEED=1.0

