# ==============================================================================
# CONFIGURACIÓN GENERAL - Scrape-DIS (AWS Academy Extractor)
# ==============================================================================
# Copia este archivo como '.env' en la raíz del proyecto y completa con tus datos:
#   copy .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CREDENCIALES DE ACCESO (AWS Academy / Canvas LMS)
# ------------------------------------------------------------------------------
# Usuario/Email y contraseña para inicio de sesión automático.
# Si se dejan en blanco, podrás iniciar sesión manualmente en el navegador abierto.
AWS_USER=tu_usuario_o_correo@ejemplo.com
AWS_PASSWORD=tu_contraseña_aqui

# URL de la página principal de módulos del curso en Canvas LMS
AWS_HOME_URL=https://awsacademy.instructure.com/courses/000000/modules

# ------------------------------------------------------------------------------
# 2. RUTAS DE ALMACENAMIENTO Y PERFIL DE NAVEGADOR
# ------------------------------------------------------------------------------
# Directorio donde se descargarán y organizarán los materiales (PDFs, videos, HTMLs).
# Puedes usar rutas absolutas o relativas.
OUTPUT_DIR=./descargas_aws

# Directorio donde Playwright almacena la sesión y cookies de Chrome.
# Permite mantener la sesión iniciada para no pedir credenciales en cada inicio.
PROFILE_DIR=./.aws_chrome_profile

# ------------------------------------------------------------------------------
# 3. CONFIGURACIÓN DE VIDEO Y FFMPEG (DESCARGAS)
# ------------------------------------------------------------------------------
# Ruta al ejecutable de FFmpeg (requerido para procesar videos y subtítulos).
# Si FFmpeg está en el PATH de Windows, puedes dejarlo vacío o indicar 'ffmpeg'.
FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe

# Grabar subtítulos en español directamente dentro del video descargado (true/false)
BURN_SUBTITLES=true

# Calidad y compresión de video descargado
VIDEO_MAX_HEIGHT=720
VIDEO_CRF=24
VIDEO_PRESET=slow
AUDIO_BITRATE=64k

# Reanudación y control de descargas
RESUME_ENABLED=true
FORCE_REDOWNLOAD=false

# ------------------------------------------------------------------------------
# 4. SIMULACIÓN DE REPRODUCCIÓN ONLINE (MODO HUMANO)
# ------------------------------------------------------------------------------
# Velocidad de reproducción para videos online (1.0 = normal, 1.25, 1.5, etc.)
SIM_VIDEO_SPEED=1.0

# Segundos de permanencia mínima por página al recorrer documentos PDF
SIM_PDF_PAGE_SECONDS=12

# Segundos de permanencia mínima al leer páginas con contenido HTML
SIM_HTML_READING_SECONDS=10

# Intervalo en segundos entre cada desplazamiento (scroll) suave en páginas HTML
SIM_SCROLL_DELAY=0.8

# ------------------------------------------------------------------------------
# 5. TIMEOUTS DE CARGA (EN SEGUNDOS)
# ------------------------------------------------------------------------------
VIEWER_LOAD_TIMEOUT=240
PAGE_RENDER_TIMEOUT=90
VIDEO_LOAD_TIMEOUT=180
AUTO_DETECT_TIMEOUT=120

# ------------------------------------------------------------------------------
# 6. SINCRONIZACIÓN CON GOOGLE DRIVE (OPCIONAL)
# ------------------------------------------------------------------------------
# Habilitar subida automática de archivos descargados a Google Drive
GOOGLE_DRIVE_ENABLED=false

# ID de la carpeta de Google Drive donde almacenar el material
GOOGLE_DRIVE_FOLDER_ID=

# Rutas a las credenciales y tokens OAuth de la API de Google Drive
GOOGLE_DRIVE_CREDENTIALS=private/credentials_drive.json
GOOGLE_DRIVE_TOKEN=private/token_drive.json
